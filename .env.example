# ── FRONTEND (Vite — bundled into browser) ───────────────────────────────────
# Get from: Supabase → Project Settings → API
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Analytics 4 (optional)
VITE_GA_ID=G-XXXXXXXXXX

# Meta Pixel ID — hardcoded directly in index.html's fbq('init', ...) call,
# so this env var is NOT required. It exists only as an optional override for
# api/_lib/metaCapi.ts (server-side Conversions API) if you ever need the
# server to send events to a different pixel than the browser code uses.
VITE_META_PIXEL_ID=

# Cashfree: "sandbox" or "production"
VITE_CASHFREE_ENV=sandbox

# ── SERVER-ONLY (Vercel env vars — NEVER prefix with VITE_) ──────────────────
# Supabase — service role key has full DB access, never expose to frontend
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# Cashfree payment gateway (get from Cashfree dashboard)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=sandbox

# Resend email service (get from resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@helmethub.in
# Where contact/exchange notifications are delivered (Cloudflare routes this to Gmail)
SUPPORT_EMAIL=support@helmethub.in

# Your live site URL — used in payment return_url
FRONTEND_URL=https://www.helmethub.in

# Google Sheets webhook (optional — for order logging)
GOOGLE_SHEET_WEBHOOK_URL=

# Shared secret for the send-order-email endpoint (generate a random 32-char string)
ORDER_EMAIL_API_KEY=

# Webhook security — NEVER set to true in production
WEBHOOK_SKIP_SIGNATURE=false

# Meta Conversions API (optional, server-side) — sends a duplicate Purchase
# event straight from cashfree-webhook.ts, deduplicated against the browser
# pixel's Purchase event via a shared event_id (the order number). Leave both
# blank to skip server-side sending entirely; the browser pixel keeps working
# either way. Get META_CAPI_TOKEN from Events Manager → pixel → Settings →
# Conversions API → System Users (requires Business Manager Admin access).
META_CAPI_TOKEN=
# Only needed while testing in Events Manager's Test Events tab — remove once
# confirmed working, or Meta won't count those events for ad optimisation.
META_TEST_EVENT_CODE=
